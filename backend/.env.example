# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-forest-monitor-demo-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL URL for Neon / Supabase, or left empty for SQLite dev)
DATABASE_URL=

# Google Earth Engine Service Account
# JSON string of the GCP Service Account credentials with Earth Engine access
GEE_SERVICE_ACCOUNT_JSON=
# Or individual fields:
EE_ACCOUNT=
EE_PRIVATE_KEY=

# Google Gemini API Key (for Officer Verification Reports)
GEMINI_API_KEY=

# Maximum allowed AOI size in square kilometers (safety cap)
MAX_AOI_SQKM=500.0
